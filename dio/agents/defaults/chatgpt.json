{
  "name": "chatgpt",
  "match_patterns": [
    "chatgpt.com",
    "chat.openai.com"
  ],
  "selectors": {
    "working": "button[data-testid='stop-button'], button[aria-label='Stop streaming'], button[aria-label='Stop generating']",
    "blocked": "button[data-testid='confirm-button'], button[data-testid='action-approval']",
    "done": "button[data-testid='send-button']:not([disabled]), button[aria-label='Send prompt']",
    "input": "#prompt-textarea, div[contenteditable='true']",
    "send_button": "button[data-testid='send-button']"
  },
  "debounce_ms": 850
}
