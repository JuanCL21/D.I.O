#!/bin/sh
# D.I.O. — AppRun Entrypoint para AppImage autónomo
set -e

SELF=$(readlink -f "$0")
HERE=${SELF%/*}

# Configuración de rutas dentro del AppDir
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="${HERE}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Garantizar que HOME del usuario se preserve y nunca apunte al squashfs temporal
if [ -z "${HOME}" ]; then
    export HOME=$(getent passwd $(id -u) | cut -d: -f6)
fi

# Variables para compatibilidad gráfica X11 / Wayland
if [ -z "${QT_QPA_PLATFORM}" ]; then
    if [ -n "${WAYLAND_DISPLAY}" ]; then
        export QT_QPA_PLATFORM="wayland;xcb"
    fi
fi

exec "${HERE}/usr/bin/dio" "$@"
